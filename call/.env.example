# Copy to call/keys.env (git-ignored, never committed). All keys stay on this machine.
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=          # Austin's Instant Voice Clone id
CARTESIA_TTS_MODEL=sonic-3.6
CARTESIA_STT_MODEL=ink-2
CARTESIA_MAX_BUFFER_MS=120
CARTESIA_PHRASE_WORDS=1     # 1 = each word as it locks (the plan); 3 = group words (experiment, with buffer 0)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_NUMBER=              # E.164, the number we call from
PUBLIC_HOST=                # ngrok/cloudflared host forwarding to PORT, no scheme (abc.ngrok.app)
PORT=8787
# RECLAIM_DEC_PUB=tcp://127.0.0.1:5557    decoder's publisher (voice.say)
# RECLAIM_CAM_PUB=tcp://127.0.0.1:5556    camera reader (cam.tick, lipread/run.py)
# RECLAIM_CALL_PUB=tcp://127.0.0.1:5558   ours (partner.text, timing.voice, call.state)
